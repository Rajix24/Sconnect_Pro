<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SportConnect Pro — Sports activities and scheduling</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/home.css">
</head>
<body>

  <% const activities = Array.isArray(data) ? data : (data && data.rows) || []; %>

  <header class="topbar">
    <a href="/" class="wordmark">SportConnect<span>Pro</span></a>
    <nav class="topnav">
      <a href="/activities">Activities</a>
      <a href="/associations">Associations</a>
      <a href="/facilities">Facilities</a>
      <a href="/about">About</a>
    </nav>
    <a href="/creneaux" class="btn btn-ghost">View schedules</a>
  </header>

  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="hero-copy">
        <p class="kicker">Sports department — municipal services online</p>
        <h1>Book a schedule. Join a club. All from home.</h1>
        <p class="lede">
          SportConnect Pro brings together municipal sports facilities, partner
          associations, and their activities, so everyone can find a place —
          at the right price and the right time.
        </p>
        <div class="hero-actions">
          <a href="/creneaux" class="btn btn-primary">View available schedules</a>
          <a href="/tarifs" class="btn btn-text">How is my price calculated?</a>
        </div>
      </div>

      <div class="hero-board" role="group" aria-label="Today's figures">
        <p class="board-label">Today</p>
        <div class="board-row">
          <span class="board-number"><%= typeof stats !== 'undefined' && stats.openSlotsToday != null ? stats.openSlotsToday : '—' %></span>
          <span class="board-desc">open schedules</span>
        </div>
        <div class="board-row">
          <span class="board-number"><%= typeof stats !== 'undefined' && stats.totalFacilities != null ? stats.totalFacilities : '—' %></span>
          <span class="board-desc">facilities open to the public</span>
        </div>
        <div class="board-row">
          <span class="board-number"><%= typeof stats !== 'undefined' && stats.totalActivities != null ? stats.totalActivities : '—' %></span>
          <span class="board-desc">activities available</span>
        </div>
      </div>
    </section>

    <!-- ACTIVITIES LEDGER -->
    <section class="section" aria-labelledby="activities-title">
      <div class="section-head">
        <h2 id="activities-title">Activities &amp; upcoming schedules</h2>
        <a href="/activites" class="link-more">All activities</a>
      </div>

      <div class="ledger" role="table" aria-label="Activity list">
        <div class="ledger-row ledger-head" role="row">
          <span role="columnheader">Activity</span>
          <span role="columnheader">Age category</span>
          <span role="columnheader">Next schedule</span>
          <span role="columnheader">Places</span>
        </div>

        <% if (typeof activities !== 'undefined' && activities.length) { %>
          <% activities.forEach(function(a) { %>
            <div class="ledger-row" role="row">
              <span role="cell" class="ledger-name"><%= a.name %></span>
              <span role="cell"><%= a.ageCategory || '—' %></span>
              <span role="cell" class="mono"><%= a.nextSlot || '—' %></span>
              <span role="cell">
                <% if (typeof a.remainingSpots === 'number' && a.remainingSpots <= 0) { %>
                  <span class="tag tag-full">full</span>
                <% } else { %>
                  <%= a.remainingSpots != null ? a.remainingSpots : '—' %>
                <% } %>
              </span>
            </div>
          <% }); %>
        <% } else { %>
          <div class="ledger-empty">No activities to display yet. Check back after the schedule is updated.</div>
        <% } %>
      </div>
    </section>

    <!-- FACILITIES -->
    <section class="section" aria-labelledby="facilities-title">
      <div class="section-head">
        <h2 id="facilities-title">Municipal facilities</h2>
        <a href="/facilities" class="link-more">All facilities</a>
      </div>

      <div class="facility-grid">
        <% if (typeof facilities !== 'undefined' && facilities.length) { %>
          <% facilities.forEach(function(f) { %>
            <article class="facility-card">
              <p class="facility-type"><%= f.type || 'Sports facility' %></p>
              <h3><%= f.name %></h3>
              <p class="facility-address"><%= f.address || '' %></p>
              <p class="facility-capacity"><%= f.capacity != null ? f.capacity + ' places' : '' %></p>
            </article>
          <% }); %>
        <% } else { %>
          <p class="ledger-empty">No facilities registered yet.</p>
        <% } %>
      </div>
    </section>

    <!-- ASSOCIATIONS -->
    <section class="section section-tight" aria-labelledby="associations-title">
      <div class="section-head">
        <h2 id="associations-title">Partner associations</h2>
        <a href="/associations" class="link-more">All associations</a>
      </div>
      <ul class="assoc-strip">
        <% if (typeof associations !== 'undefined' && associations.length) { %>
          <% associations.forEach(function(as) { %>
            <li><%= as.name %></li>
          <% }); %>
        <% } else { %>
          <li class="ledger-empty">No associations registered yet.</li>
        <% } %>
      </ul>
    </section>

    <!-- HOW IT WORKS -->
    <section class="section how">
      <h2>How it works</h2>
      <ol class="how-steps">
        <li>
          <span class="how-index">1</span>
          <div>
            <h3>Browse schedules</h3>
            <p>Filter by facility, activity, or age group to see real availability.</p>
          </div>
        </li>
        <li>
          <span class="how-index">2</span>
          <div>
            <h3>Check your price</h3>
            <p>Residence, household income, siblings, and Pass'Sport are included before booking.</p>
          </div>
        </li>
        <li>
          <span class="how-index">3</span>
          <div>
            <h3>Register and pay</h3>
            <p>Pay in one or three installments. If an activity is full, you can join the waiting list.</p>
          </div>
        </li>
      </ol>
    </section>

    <!-- PRICING NOTE -->
    <section class="section pricing-note" aria-labelledby="pricing-title">
      <h2 id="pricing-title">What influences your price</h2>
      <div class="pricing-grid">
        <div class="pricing-item">
          <p class="pricing-label">Residence</p>
          <p>+35% for residents outside the municipality.</p>
        </div>
        <div class="pricing-item">
          <p class="pricing-label">Siblings</p>
          <p>-15% from the second enrolled child, -30% from the third.</p>
        </div>
        <div class="pricing-item">
          <p class="pricing-label">Household income</p>
          <p>A discount is automatically applied based on your household income.</p>
        </div>
        <div class="pricing-item">
          <p class="pricing-label">Pass'Sport</p>
          <p>€50 deducted directly if you are eligible.</p>
        </div>
      </div>
      <p class="pricing-footnote">A minimum price of €15 applies in all cases. Payment is available in three installments.</p>
    </section>

  </main>

  <footer class="sitefoot">
    <div>
      <p class="wordmark small">SportConnect<span>Pro</span></p>
      <p>Sports department — municipal services</p>
    </div>
    <div class="sitefoot-links">
      <a href="/creneaux">Schedules</a>
      <a href="/activites">Activities</a>
      <a href="/facilities">Facilities</a>
      <a href="/associations">Associations</a>
      <a href="/tarifs">Pricing</a>
    </div>
  </footer>

</body>
</html>
